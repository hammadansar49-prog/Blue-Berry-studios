{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "electron/**",
      "tests/**",
      "test-output/**",
      "build/**",
      "dist/**",
      "scripts/**",
      "package*.json",
      "firestore.*",
      "*.md"
    ]
  }
}
