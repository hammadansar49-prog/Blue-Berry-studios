{
  "name": "karobar",
  "version": "3.0.0",
  "description": "KAROBAR - Billing & POS desktop app",
  "main": "electron/main.js",
  "author": "Hammad Ansar",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "set ELECTRON_START_URL=http://localhost:5500&& electron .",
    "icon": "node scripts/make-icon.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win",
    "test:print": "node --test scripts/print-engine.test.cjs electron/printer.test.js",
    "preview": "node scripts/local-preview.cjs",
    "build:web": "node scripts/build-web.cjs",
    "test": "node --test scripts/sync.test.cjs scripts/payment-in.test.cjs scripts/print-engine.test.cjs electron/printer.test.js electron/local-origin.test.js electron/trial.test.js",
    "dist:trial": "electron-builder --win --config trial-build.json"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.58",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.karobar.app",
    "productName": "Karobar",
    "copyright": "Copyright \u00a9 Hammad Ansar",
    "files": [
      "electron/**/*",
      "index.html",
      "google.html",
      "app.js",
      "styles.css",
      "firebase-config.js",
      "assets/**/*",
      "vendor/**/*",
      "print-engine.js",
      "print-settings.js",
      "print-settings.css",
      "invoice-print.css"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "artifactName": "KAROBAR-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Karobar",
      "installerIcon": "assets/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "uninstallerIcon": "assets/icon.ico",
      "include": "build/installer.nsh",
      "license": "build/license.txt"
    }
  }
}
