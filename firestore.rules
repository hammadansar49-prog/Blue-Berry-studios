rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function member(uid) {
      return signedIn() && exists(/databases/$(database)/documents/users/$(uid)) &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(uid)).data.get('memberUids', []);
    }
    function canReadStore(uid) { return owner(uid) || member(uid); }

    // Members can read only explicitly linked stores. Whole-store writes are
    // owner-only: allowing members to replace the JSON permits role escalation.
    match /users/{ownerUid} {
      allow read: if canReadStore(ownerUid);
      allow write: if owner(ownerUid);
    }
    match /staffMap/{staffUid} {
      allow read: if owner(staffUid) || (signedIn() && owner(resource.data.ownerUid));
      allow create: if owner(request.resource.data.ownerUid);
      allow update: if owner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if owner(resource.data.ownerUid);
    }
    match /branches/{branchId} {
      allow read: if signedIn() && canReadStore(resource.data.ownerUid);
      allow create: if owner(request.resource.data.ownerUid);
      allow update: if owner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if owner(resource.data.ownerUid);
    }
    match /branchMap/{branchUid} {
      allow read: if owner(branchUid) || (signedIn() && owner(resource.data.ownerUid));
      allow create: if owner(request.resource.data.ownerUid);
      allow update: if owner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if owner(resource.data.ownerUid);
    }
    // A branch code is an identifier, not a password. The user must first
    // authenticate with an owner/staff account explicitly linked to the store.
    match /branchLookup/{code} {
      allow get: if signedIn() && canReadStore(resource.data.ownerUid);
      allow list: if false;
      allow create: if owner(request.resource.data.ownerUid);
      allow update: if owner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if owner(resource.data.ownerUid);
    }
    match /globalBranchCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if owner(request.resource.data.ownerUid);
      allow update: if owner(resource.data.ownerUid) && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if owner(resource.data.ownerUid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
